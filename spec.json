  "expressions": {
    "_comment": "Expression control bones point straight up (Blender +Z), roll 0. Hidden = uniform local scale 0.001 (the feature shrinks to its pivot, which sits a few mm INSIDE the head surface, so nothing is rasterised; a one-axis collapse leaves slivers poking out of the curved face). Visible = (1,1,1). Never use exact 0. Blink multiplies eyeOpen_* scale.y only (the eye flattens into a closed-eye line).",
    "hiddenScale": [
      0.001,
      0.001,
      0.001
    ],
    "collapseAxis": "xyz",
    "defaultVisible": [
      "eyeOpen_L",
      "eyeOpen_R",
      "mouthSmile"
    ],
